# Copy this file to android/keystore.properties (git-ignored) and fill in YOUR values. Never commit the real file,
# the keystore, or its passwords. Keep the keystore somewhere safe and backed up OUTSIDE the repository: if it is lost,
# a new APK cannot be installed over the old one and the only way forward is an uninstall, which deletes the app's data.
#
# storeFile is a path to the .jks file (use forward slashes, or escape backslashes as \\).
storeFile=C:/Users/YOU/keys/system-release.jks
storePassword=
keyAlias=system
keyPassword=
